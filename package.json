{
  "name": "udischeduler",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:web\" \"pnpm run dev:convex\"",
    "dev:web": "vite dev --host",
    "dev:convex": "convex dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome lint --write --unsafe .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:once": "vitest run",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:cov": "vitest run --coverage --coverage.reporter=text"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@clerk/react": "^6.2.0",
    "@convex-dev/migrations": "^0.3.1",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-form": "^1.28.6",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.163.3",
    "@tanstack/react-router-devtools": "^1.163.3",
    "@tanstack/router-plugin": "^1.164.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.32.0",
    "convex-helpers": "^0.1.114",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^3.8.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "web-haptics": "^0.0.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@edge-runtime/vm": "^5.0.0",
    "@tanstack/devtools-vite": "^0.5.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "4.0.18",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.41",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "web-vitals": "^5.1.0"
  }
}
